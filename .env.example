# Auto Voice Calling Agent - Environment Configuration Example
# Copy this file to .env and configure with your service credentials.

# -----------------------------------------------------------------------------
# 1. INFRASTRUCTURE & DATABASES
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rapida
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rapida?sslmode=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_URL=http://localhost:9200

# -----------------------------------------------------------------------------
# 2. SECURITY & ENCRYPTION
# -----------------------------------------------------------------------------
JWT_SECRET=your_jwt_signing_secret_min_32_characters_here
ENCRYPTION_KEY=your_32_byte_aes_gcm_vault_encryption_key_here
COOKIE_SECRET=your_session_cookie_secret_key_here

# -----------------------------------------------------------------------------
# 3. TELEPHONY & SIP CHANNELS
# -----------------------------------------------------------------------------
# Twilio
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Telnyx
TELNYX_API_KEY=KEYXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELNYX_PHONE_NUMBER=+1234567890

# Exotel (Indic telephony)
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_token_here
EXOTEL_SUB_DOMAIN=api.exotel.com
EXOTEL_CALLER_ID=your_exotel_caller_id_here

# Native SIP Server (assistant-api listener)
SIP_PORT=4573
SIP_DOMAIN=sip.yourdomain.com
SIP_PUBLIC_IP=127.0.0.1

# -----------------------------------------------------------------------------
# 4. SPEECH-TO-TEXT (STT) PROVIDERS
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here
SARVAM_API_KEY=your_sarvam_indic_stt_tts_api_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
SPEECHMATICS_API_KEY=your_speechmatics_api_key_here

# -----------------------------------------------------------------------------
# 5. TEXT-TO-SPEECH (TTS) PROVIDERS
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here
PLAYHT_API_KEY=your_playht_api_key_here
PLAYHT_USER_ID=your_playht_user_id_here

# -----------------------------------------------------------------------------
# 6. LLM GATEWAY PROVIDERS
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# 7. AUDIO RECORDINGS & OBJECT STORAGE
# -----------------------------------------------------------------------------
RECORDING_STORAGE_TYPE=s3 # Options: local, s3, gcs
RECORDING_STORAGE_BUCKET=voice-ai-recordings
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# -----------------------------------------------------------------------------
# 8. CAMPAIGN CONCURRENCY & CALLING ENGINE DEFAULTS
# -----------------------------------------------------------------------------
DEFAULT_MAX_CONCURRENT_CALLS=10
DEFAULT_DAILY_CALL_LIMIT=1000
DEFAULT_CALL_TIMEOUT_SECONDS=60
DEFAULT_RETRY_DELAY_MINUTES=60
DEFAULT_BUSINESS_HOURS_START=09:00
DEFAULT_BUSINESS_HOURS_END=18:00
DEFAULT_TIMEZONE=Asia/Kolkata
